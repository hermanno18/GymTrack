NUXT_SESSION_PASSWORD=change-me-to-a-random-32-plus-character-string
DATABASE_PATH=./data/gymtrack.db

# Optional: password-reset emails. Without SMTP_HOST set, reset links are
# just logged to the console instead of actually emailed -- the forgot
# password flow still works end-to-end for local dev, it just won't send.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@gymtrack.local
# SMTP_USE_SSL=false
